{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right form-inline">
				<a href="{{ list }}" data-toggle="tooltip" title="{{ button_list }}" class="btn btn-info"><i class="fa fa-list-ul"></i></a> 
				<button type="button" id="button-import" data-toggle="tooltip" title="{{ button_import }}" class="btn btn-warning"><i class="fa fa-download"></i></button> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
				<button type="submit" form="form-feed" name="apply" data-toggle="tooltip" title="{{ button_apply }}" class="btn btn-success"><i class="fa fa-check"></i></button>
				<button type="submit" form="form-feed" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if error_curl %}
			<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_curl }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if success %}
			<div class="alert alert-success alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
				<span class="pull-right"><a href="https://opencartbot.com/en/merchant" target="_blank"><kbd>opencartbot</kbd></a></span>
			</div>
			<div class="panel-body">
				<ul class="nav nav-tabs">
					<li class="active"><a href="#tab-main" data-toggle="tab">{{ tab_main }}</a></li>
					<li><a href="#tab-categories" data-toggle="tab">{{ tab_categories }}</a></li>
					<li><a href="#tab-license" data-toggle="tab">{{ tab_license }}</a></li>
				</ul>
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-feed" class="form-horizontal">
					<div class="tab-content">
						<div class="tab-pane active form-horizontal" id="tab-main">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="feed_contentapi_status" id="input-status" class="form-control">
										<option value="0" {{ "0" == feed_contentapi_status ? "selected" : "" }}>{{ text_disabled }}</option>
										<option value="1" {{ "1" == feed_contentapi_status ? "selected" : "" }}>{{ text_enabled }}</option>
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_lang_prefix }}</label>
								<div class="col-sm-10">
									{% for language in languages %}
										<div class="input-group">
											<span class="input-group-addon">
												<img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" />
											</span>
											<input type="text" name="feed_contentapi_prefix[{{ language.code }}]" value="{{ feed_contentapi_prefix[language.code] ? feed_contentapi_prefix[language.code] : '' }}" placeholder="{{ language.code }}" class="form-control"/>
										</div>
									{% endfor %}
									<small>{{ help_lang_prefix }}</small>
								</div>
							</div>
						</div>

						<div class="tab-pane form-horizontal" id="tab-categories">
							<div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_import }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>
							<div id="category"></div>
							<br>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-data-feed">{{ entry_google_category }}</label>
								<div class="col-sm-10">
									<input type="text" name="category" value="" placeholder="{{ entry_store_category }}" id="input-category" class="form-control"/>
									<input type="hidden" name="category_id" value=""/>
									<br>
									<input type="text" name="google_category" value="" placeholder="{{ entry_google_category }}" id="input-google-category" class="form-control"/>
									<input type="hidden" name="google_category_id" value=""/>
									<br>
									<button type="button" id="button-category-add" class="btn btn-primary"><i class="fa fa-plus"></i> {{ button_category_add }}</button>
								</div>
							</div>
						</div>

						<div class="tab-pane form-horizontal" id="tab-license">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-license">{{ entry_license }}</label>
								<div class="col-sm-10">
									<input type="text" name="feed_contentapi_license" value="{{ feed_contentapi_license }}" placeholder="{{ entry_license }}" id="input-license" class="form-control"/>
									<br>
									{{ text_copyright }}
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<style>
#container {
    overflow: auto !important;
}
</style>
<script type="text/javascript"><!--
// Google Category
$('input[name=\'google_category\']').autocomplete({
	'source': function(request, response) {
	  $.ajax({
		url: 'index.php?route=extension/feed/contentapi/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
		dataType: 'json',
		success: function(json) {
		  response($.map(json, function(item) {
			return {
			  label: item['name'],
			  value: item['google_category_id']
			}
		  }));
		},
		error: function(xhr, ajaxOptions, thrownError) {
		  alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	  });
	},
	'select': function(item) {
	  $(this).val(item['label']);
	  $('input[name=\'google_category_id\']').val(item['value']);
  }
});

// Category
$('input[name=\'category\']').autocomplete({
	'source': function(request, response) {
		$.ajax({
			url: 'index.php?route=catalog/category/autocomplete&user_token={{ user_token }}&filter_name=' +  encodeURIComponent(request),
			dataType: 'json',
			success: function(json) {
				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['category_id']
					}
				}));
			},
			error: function(xhr, ajaxOptions, thrownError) {
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});
	},
	'select': function(item) {
	  $(this).val(item['label']);
	  $('input[name="category_id"]').val(item['value']);
	}
});

$('#category').delegate('.pagination a', 'click', function(e) {
	e.preventDefault();

	$('#category').load(this.href);
});

$('#category').load('index.php?route=extension/feed/contentapi/category&user_token={{ user_token }}');

$('#button-category-add').on('click', function() {
	$.ajax({
		url: 'index.php?route=extension/feed/contentapi/addCategory&user_token={{ user_token }}',
		type: 'post',
		dataType: 'json',
		data: 'google_category_id=' + $('input[name=\'google_category_id\']').val() + '&category_id=' + $('input[name=\'category_id\']').val(),
		beforeSend: function() {
			$('#button-category-add').button('loading');
		},
		complete: function() {
			$('#button-category-add').button('reset');
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			if (json['error']) {
				$('#category').before('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}

			if (json['success']) {
				$('#category').load('index.php?route=extension/feed/contentapi/category&user_token={{ user_token }}');

				$('#category').before('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');

				$('input[name=\'category\']').val('');
		  		$('input[name=\'category_id\']').val('');
		  		$('input[name=\'google_category\']').val('');
		  		$('input[name=\'google_category_id\']').val('');
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('#category').delegate('.btn-danger', 'click', function() {
	var node = this;

	$.ajax({
		url: 'index.php?route=extension/feed/contentapi/removeCategory&user_token={{ user_token }}',
		type: 'post',
		data: 'category_id=' + encodeURIComponent(this.value),
		dataType: 'json',
		crossDomain: true,
		beforeSend: function() {
			$(node).button('loading');
		},
		complete: function() {
			$(node).button('reset');
		},
		success: function(json) {
			$('.alert-dismissible').remove();

			// Check for errors
			if (json['error']) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}

	  		if (json['success']) {
				$('#category').load('index.php?route=extension/feed/contentapi/category&user_token={{ user_token }}');

				$('#category').before('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('#button-import').on('click', function() {
	$('#form-upload').remove();

	$('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

	$('#form-upload input[name=\'file\']').trigger('click');

	if (typeof timer != 'undefined') {
		clearInterval(timer);
	}

	timer = setInterval(function() {
		if ($('#form-upload input[name=\'file\']').val() != '') {
			clearInterval(timer);

			$.ajax({
				url: 'index.php?route=extension/feed/contentapi/import&user_token={{ user_token }}',
				type: 'post',
				dataType: 'json',
				data: new FormData($('#form-upload')[0]),
				cache: false,
				contentType: false,
				processData: false,
				beforeSend: function() {
					$('#button-import').button('loading');
				},
				complete: function() {
					$('#button-import').button('reset');
				},
				success: function(json) {
					$('.alert-dismissible').remove();

				  	if (json['error']) {
						$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
					}

					if (json['success']) {
						$('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
					}
				},
				error: function(xhr, ajaxOptions, thrownError) {
					alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
				}
			});
		}
	}, 500);
});
//--></script>
{{ footer }}