$(document).ready(function(){
	setInterval('visibility()', 500);

	$('.add-field').on('click', function(e){
		e.preventDefault();
		let fieldName = $(this).data('field');
		$('#'+fieldName).toggle();
		$('#'+fieldName+' input').val('');
	});

	var i = {{ param_row }}; 

	// Options
	$('#add_option').on('click', function(){
	  let html = '';
	  html = '<div class="form-group" id="item_'+i+'">';
		html += '<label class="col-sm-2 control-label" for="filter_'+i+'">';
		  html += '{{ entry_option_name }}';
		html += '</label>';
		html += '<div class="col-sm-4">';
		  html += '<select class="form-control opt" name="filter['+i+']" id="filter_'+i+'">';
			html += '<option>{{ text_none }}</option>';
			{% for option in options %}
			  html += `<option value="{{ option.option_id }}">{{ option.name }}</option>`;
			{% endfor %}
		  html += '</select>';
		html += '</div>';
		html += '<label class="col-sm-1 control-label" for="filterv_'+i+'">';
		  html += '{{ entry_option_value }}';
		html += '</label>';
		html += '<div class="col-sm-4">';
		  html += '<select class="form-control optv" name="filterv['+i+']" id="filterv_'+i+'">';
			html += '<option>{{ text_none }}</option>';
		  html += '</select>';
		html += '</div>';
		html += '<div class="col-sm-1">';
		  html += '<button type="button" class="btn btn-danger remove"><i class="fa fa-minus-circle"></i></button>';
		html += '</div>';
	  html += '</div>';
	  $('#filter').append(html);
	  i++;
	});

	$(document).on('change', '.opt', function(){
	  var option_id = $(this).val(),
		row_id = $(this).attr('id'),
		row_arr = row_id.split('_'),
		row_num = row_arr[1],
		opt_name = $("#filter_"+row_num+" option:selected").text();
	  $("#filterv_"+row_num).empty();
	  $.ajax({
		url: 'index.php?route=catalog/option/autocomplete&user_token={{ user_token }}&filter_name='+opt_name,
		dataType: 'json',
		success: function(json) {
		  for (value in json){
			if (json[value]['option_id'] == option_id){
			  for (item in json[value]['option_value']){
				$("#filterv_"+row_num).append('<option value="'+json[value]['option_value'][item]['option_value_id']+'">'+json[value]['option_value'][item]['name']+'</option>');
			  }
			}
		  }
		}
	  });
	});

	// Attributes
	$('#add_attribute').on('click', function(){
	  let html = '';
	  html = '<div class="form-group" id="item_'+i+'">';
		html += '<label class="col-sm-2 control-label" for="filter_'+i+'">';
		  html += '{{ entry_attribute_name }}';
		html += '</label>';
		html += '<div class="col-sm-4">';
		  html += '<select class="form-control attr" name="filtera['+i+']" id="filter_'+i+'">';
			html += '<option>{{ text_none }}</option>';
			{% for attribute in attributes %}
			  html += `<option value="{{ attribute.attribute_id }}">{{ attribute.name }}</option>`;
			{% endfor %}
		  html += '</select>';
		html += '</div>';
		html += '<label class="col-sm-1 control-label" for="filterv_'+i+'">';
		  html += '{{ entry_attribute_value }}';
		html += '</label>';
		html += '<div class="col-sm-4">';
		  html += '<input type="text" class="form-control attrv" name="filterva['+i+']" id="filterv_'+i+'">';
		html += '</div>';
		html += '<div class="col-sm-1">';
		  html += '<button type="button" class="btn btn-danger remove"><i class="fa fa-minus-circle"></i></button>';
		html += '</div>';
	  html += '</div>';
	  $('#filter').append(html);
	  i++;
	});

	// Filters
	$('#add_filter').on('click', function(){
	  let html = '';
	  html = '<div class="form-group" id="item_'+i+'">';
		html += '<label class="col-sm-2 control-label" for="filterf_'+i+'">';
		  html += '{{ entry_filter_name }}';
		html += '</label>';
		html += '<div class="col-sm-4">';
		  html += '<select class="form-control filter" name="filterf['+i+']" id="filterf_'+i+'">';
			html += '<option>{{ text_none }}</option>';
			{% for filter_g in filters %}
			  html += `<option value="{{ filter_g.filter_group_id }}">{{ filter_g.name }}</option>`;
			{% endfor %}
		  html += '</select>';
		html += '</div>';
		html += '<label class="col-sm-1 control-label" for="filtervf_'+i+'">';
		  html += '{{ entry_filter_value }}';
		html += '</label>';
		html += '<div class="col-sm-4">';
		  html += '<select class="form-control filtervf" name="filtervf['+i+']" id="filtervf_'+i+'">';
			html += '<option>{{ text_none }}</option>';
		  html += '</select>';
		html += '</div>';
		html += '<div class="col-sm-1">';
		  html += '<button type="button" class="btn btn-danger remove"><i class="fa fa-minus-circle"></i></button>';
		html += '</div>';
	  html += '</div>';
	  $('#filter').append(html);
	  i++;
	});

	$(document).on('change', 'select.filter', function(){
	  var filter_group_id = $(this).val(),
		row_id = $(this).attr('id'),
		row_arr = row_id.split('_'),
		row_num = row_arr[1];
	  $("#filtervf_"+row_num).empty();
	  $.ajax({
		url: 'index.php?route=extension/feed/contentapi/getFilters&user_token={{ user_token }}&filter_group_id='+filter_group_id,
		dataType: 'json',
		success: function(json) {
		  json.forEach(function(value, index) {
			$("#filtervf_"+row_num).append('<option value="'+value['filter_id']+'">'+value['name']+'</option>');
		  });
		}
	  });
	});

	// Removing
	$(document).on('click','.remove', function(){
	  $(this).closest('.form-group').remove();
	});

	// Programs
	$(".programs .checkbox input").change(function() {
		if(this.checked) {
			if ($(this).attr('name') == 'destination[]') {
				$(".programs-excluded .checkbox input[value='"+$(this).val()+"']").prop( "checked", false );
			} else {
				$(".programs-included .checkbox input[value='"+$(this).val()+"']").prop( "checked", false );
			}
		}
	});

});
