<script type="text/javascript"><!--
var bar = $('#progress-bar');

function updateCatalog() {
	bar.addClass('active').addClass('progress-bar-striped').removeClass('progress-bar-success');
	bar.text('').css('width', '0%');
	startUpload();
}

function startUpload(start = 0, total = 0, counter = 0) {
	$.ajax({
		url: '{{ server }}index.php?route=extension/feed/contentapi/updateCatalog&feed_id={{ feed_id }}&start=' + start + '&total=' + total + '&counter=' + counter,
		type: 'post',
		data: $('#tab-update input[type=\'hidden\']'),
		dataType: 'json',
		cache: false,
		beforeSend: function() {
			$('#updateCatalog').button('loading');
			$('.alert-success').remove();
		},
		complete: function() {
			$('#updateCatalog').button('reset');
		},
		success: function(result) {
			bar.text(result['percent'] + '%').css('width', result['percent'] + '%');
			if (parseInt(result['start']) < result['total']) {
				setTimeout(function () {
					startUpload(result['start'], result['total'], result['counter']);
				}, 100);
			} else {
				bar.removeClass('active').removeClass('progress-bar-striped').addClass('progress-bar-success');
				$('#updateCatalog').after('<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_product_count }} ' + result['counter'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
		}
	});
}

function visibility(selector = '.form-group') {
	$.each($(selector), function(index, item){
		var parent = $(item).data('parent-id');
		var value = $(item).data('parent-value');
		if (parent) {
			if ($(parent).val() == value || ($(parent + ' input:checked').val() == value && $(parent).is(':visible'))) {
				$(item).css('background', '#e9f1fe').show(400);
			} else {
				$(item).hide(400);
			}
		}
	});
}

