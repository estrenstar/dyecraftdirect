{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right form-inline">
				<button type="submit" form="form-feed" name="apply" data-toggle="tooltip" title="{{ button_apply }}" class="btn btn-success"><i class="fa fa-check"></i></button>
				<button type="submit" form="form-feed" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if monolog %}
			<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_monolog }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if success %}
			<div class="alert alert-success alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit_feed }} {{ label ? label : '' }}</h3>
				<span class="pull-right"><a href="https://opencartbot.com/en/merchant" target="_blank"><kbd>opencartbot</kbd></a></span>
			</div>
			<div class="panel-body">
				<ul class="nav nav-tabs">
					<li class="active"><a href="#tab-main" data-toggle="tab">{{ tab_main }}</a></li>
					<li><a href="#tab-shipping" data-toggle="tab">{{ tab_shipping }}</a></li>
					<li><a href="#tab-filters" data-toggle="tab">{{ tab_filters }}</a></li>
					<li><a href="#tab-blacklist" data-toggle="tab">{{ tab_blacklist }}</a></li>
					<li><a href="#tab-update" data-toggle="tab">{{ tab_update }}</a></li>
					<li><a href="#tab-cron" data-toggle="tab">{{ tab_cron }}</a></li>
					<li><a href="#tab-log" data-toggle="tab">{{ tab_log }}</a></li>
				</ul>
				<form action="{{ save }}" method="post" enctype="multipart/form-data" id="form-feed" class="form-horizontal">
					<div class="tab-content">
						<div class="tab-pane active form-horizontal" id="tab-main">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="status" id="input-status" class="form-control">
										<option value="0" {{ "0" == status ? "selected" : "" }}>{{ text_disabled }}</option>
										<option value="1" {{ "1" == status ? "selected" : "" }}>{{ text_enabled }}</option>
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-store">{{ entry_store }}</label>
								<div class="col-sm-10">
									<select id="input-store" name="store_id" class="form-control">
										<option value="0" {{ store_id == '0' ? 'selected' }}>{{ text_default }}</option>
										{% for store in stores %}
											<option value="{{ store.store_id }}" {{ store_id == store.store_id ? "selected" : "" }}>{{ store.name }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_label }}</label>
								<div class="col-sm-10">
									<input type="text" name="label" value="{{ label }}" placeholder="{{ entry_label }}" class="form-control"/>
									{% if error_label %}
										<div class="text-danger">{{ error_label }}</div>
									{% endif %}
									<small>{{ help_label }}</small>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-language">{{ entry_language }}</label>
								<div class="col-sm-10">
									<select id="input-language" name="language" class="form-control">
										{% for language_code,language_data in languages %}
											<option value="{{ language_data.language_id }}" {{ language_data.language_id == language ? "selected" : "" }}>{{ language_data.name }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-currency">{{ entry_currency }}</label>
								<div class="col-sm-10">
									<select name="currency" id="input-currency" class="form-control">
										{% for currency_data in currencies %}
											<option value="{{ currency_data.code }}" {{ currency_data.code == currency ? "selected" : "" }}>{{ currency_data.code }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_merchantid }}</label>
								<div class="col-sm-10">
									<input type="text" name="merchantid" value="{{ merchantid }}" placeholder="{{ entry_merchantid }}" class="form-control"/>
									{% if error_merchantid %}
										<div class="text-danger">{{ error_merchantid }}</div>
									{% endif %}
									<small>{{ help_merchantid }}</small>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-key"><span class="help" title="{{ help_key }}" data-toggle="tooltip">{{ entry_key }}</span></label>
								<div class="col-sm-10">
									<textarea name="key" placeholder="json" id="input-key" rows="6" class="form-control">{{ key }}</textarea>
									<small>{{ help_key_manual }}</small>
									{% if error_key %}
										<div class="text-danger">{{ error_key }}</div>
									{% endif %}
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_channel }}</label>
								<div class="col-sm-10">
									<select name="channel" id="input-channel" class="form-control">
										<option value="online" {{ "online" == channel ? "selected" : "" }}>{{ text_online }}</option>
										<option value="local" {{ "local" == channel ? "selected" : "" }}>{{ text_local }}</option>
									</select>
								</div>
							</div>
							<div class="form-group" data-parent-id="#input-channel" data-parent-value="local">
								<label class="col-sm-2 control-label">{{ entry_local_stores }}</label>
								<div class="col-sm-10">
									<table id="store-table" class="table table-striped table-bordered table-hover" style="background:#ffffff">
										<thead>
											<td>{{ entry_store_code }}</td>
											<td></td>
										</thead>
										<tbody>
											{% set store_row = 0 %}
											{% if store_code %} 
												{% for item in store_code %}
												<tr id="store-row{{ store_row }}">
													<td class="text-left">
														<input type="text" name="store_code[{{ store_row }}]" value="{{ item }}" placeholder="{{ entry_store_code }}" class="form-control"/>
													</td>
													<td class="text-left">
														<button type="button" onclick="$('#store-row{{ store_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
													</td>
												</tr>
												{% set store_row = store_row + 1 %} 
												{% endfor %}  
											{% endif %} 
										</tbody>
										<tfoot>
											<tr>
												<td></td>
												<td class="text-left">
													<button type="button" onclick="addStoreCode();" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button>
												</td>
											</tr>
										</tfoot>
									</table>
								</div>
							</div>
							<div class="form-group programs" data-parent-id="#input-channel" data-parent-value="online">
								<label class="col-sm-2 control-label" for="input-destination">{{ entry_destination }}</label>
								<div class="col-sm-5 programs-included">
									<strong class="text-success">{{ entry_included }}</strong>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Shopping_ads" {{ "Shopping_ads" in destination ? "checked" : "" }}/> {{ text_Shopping_ads }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Display_ads" {{ "Display_ads" in destination ? "checked" : "" }}/> {{ text_Display_ads }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Free_listings" {{ "Free_listings" in destination ? "checked" : "" }}/> {{ text_Free_listings }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Cloud_retail" {{ "Cloud_retail" in destination ? "checked" : "" }}/> {{ text_Cloud_retail }}</label>
									</div>
								</div>
								<div class="col-sm-5 programs-excluded">
									<strong class="text-warning">{{ entry_excluded }}</strong>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Shopping_ads" {{ "Shopping_ads" in excluded ? "checked" : "" }}/> {{ text_Shopping_ads }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Display_ads" {{ "Display_ads" in excluded ? "checked" : "" }}/> {{ text_Display_ads }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Free_listings" {{ "Free_listings" in excluded ? "checked" : "" }}/> {{ text_Free_listings }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Cloud_retail" {{ "Cloud_retail" in excluded ? "checked" : "" }}/> {{ text_Cloud_retail }}</label>
									</div>
								</div>
							</div>
							<div class="form-group programs" data-parent-id="#input-channel" data-parent-value="local">
								<label class="col-sm-2 control-label" for="input-destination">{{ entry_destination }}</label>
								<div class="col-sm-5 programs-included">
									<strong class="text-success">{{ entry_included }}</strong>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Local_inventory_ads" {{ "Local_inventory_ads" in destination ? "checked" : "" }}/> {{ text_Local_inventory_ads }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Free_local_listings" {{ "Free_local_listings" in destination ? "checked" : "" }}/> {{ text_Free_local_listings }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="destination[]" value="Local_cloud_retail" {{ "Local_cloud_retail" in destination ? "checked" : "" }}/> {{ text_Local_cloud_retail }}</label>
									</div>
								</div>
								<div class="col-sm-5 programs-excluded">
									<strong class="text-warning">{{ entry_excluded }}</strong>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Local_inventory_ads" {{ "Local_inventory_ads" in excluded ? "checked" : "" }}/> {{ text_Local_inventory_ads }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Free_local_listings" {{ "Free_local_listings" in excluded ? "checked" : "" }}/> {{ text_Free_local_listings }}</label>
									</div>
									<div class="checkbox">
										<label><input type="checkbox" name="excluded[]" value="Local_cloud_retail" {{ "Local_cloud_retail" in excluded ? "checked" : "" }}/> {{ text_Local_cloud_retail }}</label>
									</div>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-offerid">{{ entry_offerid }}</label>
								<div class="col-sm-10">
									<div class="input-group">
										<div class="input-group-addon" style="padding:0;border:0;">
											<input type="text" name="prefix" value="{{ prefix }}" placeholder="{{ entry_prefix }}" style="width:120px;" class="form-control"/>
										</div>
										<select name="offerid" id="input-offerid" class="form-control">
											{% for field in fields %}
											<option value="{{ field }}" {{ field == offerid ? "selected" : "" }}>{{ field }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-product-name">{{ entry_product_name }}</label>
								<div class="col-sm-10">
									<select name="product_name" id="input-product-name" class="form-control">
										<option value="name" {{ "name" == product_name ? "selected" : "" }}>Name</option>
										<option value="meta_title" {{ "meta_title" == product_name ? "selected" : "" }}>Meta Title</option>
										<option value="meta_h1" {{ "meta_h1" == product_name ? "selected" : "" }}>H1</option>
									</select>
									<a class="add-field" data-field="add-prefix" style="cursor:pointer"><kbd>{{ entry_add_prefix }}</kbd></a>&nbsp;&nbsp;<a class="add-field" data-field="add-suffix" style="cursor:pointer"><kbd>{{ entry_add_suffix }}</kbd></a>
									<div id="add-prefix" {{ name_prefix ? '' : 'style="display:none;"' }}>
										<label class="control-label">{{ entry_name_prefix }}</label>
										<input type="text" name="name_prefix" value="{{ name_prefix }}" placeholder="{{ entry_name_prefix }}" class="form-control"/>
										<small>{{ entry_shortcodes }}</small>
									</div>
									<div id="add-suffix" {{ name_suffix ? '' : 'style="display:none;"' }}>
										<label class="control-label">{{ entry_name_suffix }}</label>
										<input type="text" name="name_suffix" value="{{ name_suffix }}" placeholder="{{ entry_name_suffix }}" class="form-control"/>
										<small>{{ entry_shortcodes }}</small>
									</div>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-product-name">{{ entry_product_description }}</label>
								<div class="col-sm-10">
									<select name="product_description" id="input-product-description" class="form-control">
										<option value="description" {{ "description" == product_description ? "selected" : "" }}>Description</option>
										<option value="meta_description" {{ "meta_description" == product_description ? "selected" : "" }}>Meta Description</option>
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-striptags">{{ entry_striptags }}</label>
								<div class="col-sm-10">
									<select name="striptags" id="input-striptags" class="form-control">
										<option value="0" {{ "0" == striptags ? "selected" : "" }}>{{ text_no }}</option>
										<option value="1" {{ "1" == striptags ? "selected" : "" }}>{{ text_yes }}</option>
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-gtin">{{ entry_gtin }}</label>
								<div class="col-sm-10">
									<select name="gtin" id="input-gtin" class="form-control">
										<option value="0">{{ text_none }}</option>
										<option value="no" {{ "no" == gtin ? "selected" : "" }}>{{ text_nogtin }}</option>
										{% for field in fields %}
											<option value="{{ field }}" {{ field == gtin ? "selected" : "" }}>{{ field }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-mpn">{{ entry_mpn }}</label>
								<div class="col-sm-10">
									<select name="mpn" id="input-mpn" class="form-control">
										<option value="0">{{ text_none }}</option>
										{% for field in fields %}
											<option value="{{ field }}" {{ field == mpn ? "selected" : "" }}>{{ field }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-stock">{{ entry_stock }}</label>
								<div class="col-sm-10">
									<select name="stock" id="input-stock" class="form-control">
										<option value="0" {{ "0" == stock ? "selected" : "" }}>{{ entry_always_available }}</option>
										<option value="1" {{ "1" == stock ? "selected" : "" }}>{{ entry_always_preorder }}</option>
										<option value="3" {{ "3" == stock ? "selected" : "" }}>{{ entry_quantity_based }}</option>
									</select>
								</div>
							</div>
							<div class="form-group" data-parent-id="#input-stock" data-parent-value="3">
								<label class="col-sm-2 control-label">{{ entry_stock_assign }}</label>
								<div class="col-sm-10">
									<table class="table table-bordered table-hover" style="background:#ffffff">
										<thead>
											<th>{{ entry_your_stock_status }}</th>
											<th>{{ entry_default_stock_status }}</th>
										</thead>
										<tbody>
											{% for stock_status in stock_statuses %}
												<tr>
													<td><strong>{{ stock_status.name }}</strong></td>
													<td><select name="stock_assign[{{ stock_status.stock_status_id }}]" class="form-control">
														{% for default_status in default_statuses %}
															<option value="{{ default_status }}" {{ default_status == stock_assign[stock_status.stock_status_id] ? "selected" : "" }}>{{ attribute(_context, 'text_'~default_status) }}</option>
														{% endfor %}
													</select></td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_preorder }}</label>
								<div class="col-sm-10">
									<div class="input-group" style="max-width:300px">
										<div class="input-group-addon"> + </div>
										<input type="number" min="0" max="365" name="preorder" value="{{ preorder }}" placeholder="{{ entry_preorder }}" class="form-control"/>
										<div class="input-group-addon">{{ text_days }}</div>
									</div>
									<small>{{ help_preorder }}</small>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-condition">{{ entry_condition }}</label>
								<div class="col-sm-10">
									<select name="condition" id="input-condition" class="form-control">
										<option value="0" {{ "0" == condition ? "selected" : "" }}>{{ entry_always_new }}</option>
										<option value="1" {{ "1" == condition ? "selected" : "" }}>{{ entry_always_used }}</option>
										<option value="2" {{ "2" == condition ? "selected" : "" }}>{{ entry_always_refurbished }}</option>
										<option value="3" {{ "3" == condition ? "selected" : "" }}>{{ entry_product_status }}</option>
									</select>
								</div>
							</div>
							<div class="form-group" data-parent-id="#input-condition" data-parent-value="3">
								<label class="col-sm-2 control-label">{{ entry_condition_field }}</label>
								<div class="col-sm-3">
									<input type="text" name="condition_field" value="{{ condition_field }}" placeholder="{{ entry_condition_field }}" class="form-control"/>
									<small>{{ text_eg }} upc</small>
								</div>
								<div class="col-sm-3">
									<input type="text" name="condition_table" value="{{ condition_table }}" placeholder="{{ entry_condition_table }}" class="form-control"/>
									<small>{{ text_eg }} oc_product</small>
								</div>
								<div class="col-sm-4">
									{{ help_condition_field }}
								</div>
							</div>
							<div class="form-group" data-parent-id="#input-condition" data-parent-value="3">
								<label class="col-sm-2 control-label">{{ entry_condition_assign }}</label>
								<div class="col-sm-10">
									<table class="table table-bordered table-hover" style="background:#ffffff">
										<thead>
											<th>{{ entry_default_condition }}</th>
											<th>{{ entry_field_value }}</th>
										</thead>
										<tbody>
											{% for condition in default_conditions %}
												<tr>
													<td><strong>{{ attribute(_context, 'text_'~condition) }}</strong></td>
													<td><input type="text" placeholder="{{ entry_field_value }}" name="condition_assign[{{ condition }}]" value="{{ condition_assign[condition] }}" class="form-control"></td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-dimension">{{ entry_dimension }}</label>
								<div class="col-sm-10">
									<select name="dimension" id="input-dimension" class="form-control">
										<option value="0" {{ "0" == dimension ? "selected" : "" }}>{{ text_disabled }}</option>
										<option value="1" {{ "1" == dimension ? "selected" : "" }}>{{ text_enabled }}</option>
									</select>
								</div>
							</div>
							<div class="form-group" data-parent-id="#input-dimension" data-parent-value="1">
								<label class="col-sm-2 control-label">{{ entry_dimension_assign }}</label>
								<div class="col-sm-10">
									<table class="table table-bordered table-hover" style="background:#ffffff">
										<thead>
											<th>{{ entry_in_store }}</th>
											<th>{{ entry_multiplier }}</th>
											<th>{{ entry_in_merchant }}</th>
										</thead>
										<tbody>
											{% for class in length_classes %}
												<tr>
													<td><strong>{{ class['unit'] }}</strong></td>
													<td><input type="text" placeholder="1" name="dimension_assign[{{ class['length_class_id'] }}][multiplier]" value="{{ dimension_assign[class['length_class_id']]['multiplier'] }}" class="form-control"></td>
													<td>
														<select name="dimension_assign[{{ class['length_class_id'] }}][unit]" class="form-control">
															<option value="cm" {{ "cm" == dimension_assign[class['length_class_id']]['unit'] ? "selected" : "" }}>cm</option>
															<option value="in" {{ "in" == dimension_assign[class['length_class_id']]['unit'] ? "selected" : "" }}>in</option>
														</select>
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>

							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-weight">{{ entry_weight }}</label>
								<div class="col-sm-10">
									<select name="weight" id="input-weight" class="form-control">
										<option value="0" {{ "0" == weight ? "selected" : "" }}>{{ text_disabled }}</option>
										<option value="1" {{ "1" == weight ? "selected" : "" }}>{{ text_enabled }}</option>
									</select>
								</div>
							</div>
