<div class="table-responsive">
	<table class="table table-bordered table-hover">
	<thead>
		<tr>
		<td class="text-center">{{ column_customer_id }}</td>
		<td class="text-center col-sm-4">{{ column_cart }}</td>
		<td class="text-center">{{ column_work_log }}</td>
		<td class="text-center col-sm-2">{{ column_action }}</td>
		</tr>
	</thead>
	<tbody>
		{% if records %}
		{% for record in records %}
		<tr {{ record.is_abandoned? 'class="danger"' : '' }}>
		<td>
			<table class="table table-bordered table-hover">
				{% if type == 'customer' or type == 'guest' %}
				<tr class="hb_customer_name">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Customer Name"><i class="fa fa-user"></i></span></td>
					<td><a href="{{ record.customer_link }}" target="_blank">{{ record.customer_info.firstname~' '~record.customer_info.lastname }}[{{ record.customer_id }}]</a></td>
				</tr>
				<tr class="hb_email">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Customer Email"><i class="fa fa-envelope"></i></span></td>
					<td>{{ record.customer_info.email }}</td>
				</tr>
				<tr class="hb_phone">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Customer Phone"><i class="fa fa-phone"></i></span></td>
					<td>{{ record.customer_info.telephone }}</td>
				</tr>

				<tr class="hb_since">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Customer Since"><i class="fa fa-info"></i></span></td>
					<td>{{ record.customer_since }}</td>
				</tr>
				
				<tr class="hb_purchases">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Total Previous Purchases"><i class="fa fa-money"></i></span></td>
					<td>{{ record.customer_purchases }}</td>
				</tr>
				{% endif %}

				<tr class="hb_session">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Customer Session ID"><i class="fa fa-street-view"></i></span></td>
					<td>{{ record.session_id }}</td>
				</tr>
				<tr class="hb_ip">
					<td class="text-center"><span data-toggle="tooltip" title="" data-original-title="Customer IP"><i class="fa fa-globe"></i></span></td>
					<td> {{ record.ip }}</td>
				</tr>						
			</table>
		</td>
		<td class="col-sm-4">
			<table class="table table-bordered">
			{% for cart in record['cart'] %}
				<tr>
					<td class="text-center"><img src="{{ cart.image }}"/></td>
					<td><span style="color:#3399CC; font-weight:bold;">{{ cart.name }}</span> [{{ cart.model }}]
							{% if cart.option %}
							{% for option in cart['option'] %}
							<br /><small><b>{{ option.name }}</b>: {{ option.value }}</small>
							{% endfor %}
							{% endif %}
					</td>
					<td>x {{ cart.quantity }}</td>
					<td>{{ cart.total }}</td>
				</tr>
			{% endfor %}
			</table>
			{% if record.last_visited != '' %}
			<span class="hb_last_visited"><b>{{ text_last_visited }} :</b> {{ record.last_visited }}</span>
			{% endif %}	
		</td>
		
		<td class="text-left">
			<table class="table table-bordered table-hover">
				{% if type == 'customer' or type == 'guest' %}
				<tr class="hb_first_email_sent">
					<td class="text-left col-sm-4">{{ text_first_email_sent }}</td>
					<td class="text-left">{{ record.email_sent }}</td>
				</tr>
				<tr class="hb_email_viewed">
					<td class="text-left">{{ text_email_viewed }}</td>
					<td class="text-left">{{ record.email_viewed }}</td>
				</tr>
				<tr class="hb_reminder">
					<td class="text-left">{{ text_reminder }}</td>
					<td class="text-left">{{ record.reminder }}</td>
				</tr>
				{% endif %}

				<tr class="hb_date_active">
					<td class="text-left">{{ text_date_active }}</td>
					<td class="text-left">{{ record.date_added }}</td>
				</tr>
				<tr class="hb_date_modified">
					<td class="text-left">{{ text_date_modified }}</td>
					<td class="text-left">{{ record.date_modified }}</td>
				</tr>
				<tr class="hb_time_inactive">
					<td class="text-left">{{ text_time_inactive }}</td>
					<td class="text-left">{{ record.hours_inactive }}HRS</td>
				</tr>
				{% if record.last_visited != '' %}
				<tr class="hb_last_visited">
					<td class="text-left">{{ text_last_visited }}</td>
					<td class="text-left"><a href="{{ record.last_visited }}" target="_blank" data-toggle="tooltip" title="{{ record.last_visited }}" class="btn btn-sm btn-default">{{ text_last_visited }}&nbsp;<i class="fa fa-external-link"></i></a></td>
				</tr>
				{% endif %}	
			</table>
		</td>
		
		
		<td class="text-center col-sm-2">
		{% if type == 'customer' or type == 'guest' %}
			{% if record.first_email == 0 %}
				<div class="col-sm-12" style="margin-bottom:10px;"><a class="btn btn-success col-sm-12 button-email" onclick="emailPreview('{{ record.customer_id }}', '{{ record.session_id }}',0);" ><i class="fa fa-envelope"></i> Send Email</a></div>
			{% else %} 
				<div class="col-sm-12" style="margin-bottom:10px;"><a class="btn btn-warning col-sm-12 button-email" onclick="emailPreview('{{ record.customer_id }}', '{{ record.session_id }}', 1)" ><i class="fa fa-envelope"></i> Send Reminder Email</a></div>
			{% endif %}
		{% endif %}

		<div class="col-sm-12" style="margin-bottom:10px;"><a class="btn btn-danger col-sm-12" onclick="deleteCart('{{ record.session_id }}');" id="button-deletecart"><i class="fa fa-trash"></i> Delete Record</a></div>
		</td>
		</tr>
		{% endfor %}
		{% else %} 
		<tr><td class="text-center" colspan="4">No Records Found</td></tr>
		{% endif %}				
	</tbody>
	</table>
</div>
	<div class="row">
		<div class="col-sm-6 text-left">{{ pagination }}</div>
		<div class="col-sm-6 text-right">{{ results }}</div>
	</div>
</div>