<div class="table-responsive">
	<table class="table table-bordered table-hover">
	<thead>
		<tr>
		<td class="text-center">ID</td>
		<td class="text-left">Email</td>
		<td class="text-center">Customer Notified</td>
		<td class="text-center">Total Reminders</td>
		<td class="text-center">Email Viewed</td>
		<td class="text-center">Conversion</td>
		<td class="text-right">Order ID</td>
		<td class="text-right">Order Total</td>
		<td class="text-right">Date Added</td>
		<td class="text-right">Date Modified</td>
	 </tr>
	</thead>
	<tbody>
		{% if records %}
		<tr class="success">
			<td class="text-center"></td>
			<td class="text-left">Unique Emails: {{ total_unique_emails }}</td>
			<td class="text-center">Total Notifications: {{ total_notified }}</td>
			<td class="text-center">Total Reminders: {{ total_reminder_email }}</td>
			<td class="text-center">Noticed: {{ total_email_viewed }}</td>
			<td class="text-center">Conversions: {{ total_responded }}({{ conversion_rate }}%)</td>
			<td class="text-right">Total Orders: {{ total_orders }}</td>
			<td class="text-right">Total Sales: {{ total_sales }}</td>
			<td class="text-right"></td>
			<td class="text-right"></td>
		</tr>
		{% for record in records %}
		<tr>
			<td class="text-center">{{ record.id }}</td>
			<td class="text-left">{{ record.email }}</td>
			<td class="text-center">{{ record.first_email }}</td>
			<td class="text-center">{{ record.reminder }}</td>
			<td class="text-center">{{ record.email_viewed }}</td>
			<td class="text-center">{{ record.conversion }}</td>
			<td class="text-right">{{ record.order_id }}</td>
			<td class="text-right">{{ record.totals }}</td>
			<td class="text-right">{{ record.date_added }}</td>
			<td class="text-right">{{ record.date_modified }}</td>
		</tr>
		{% endfor %}
		{% else %} 
			<tr><td class="text-center" colspan="10">No Records Found</td></tr>
		{% endif %}				
	</tbody>
	</table>
</div>
	<div class="row">
	 <div class="col-sm-6 text-left">{{ pagination }}</div>
	 <div class="col-sm-6 text-right">{{ results }}</div>
	</div>
</div>

