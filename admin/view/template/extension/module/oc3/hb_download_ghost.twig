<div class="table-responsive">
<table class="table table-bordered table-hover">
	<thead>
	<tr>
		<td class="text-left">{{ column_ghost }}</td>
	</tr>
	</thead>
	<tbody>
	{% if ghost_files %}
	{% for ghost_file in ghost_files %}
	<tr>
		<td class="text-left">{{ ghost_file }}</td>
	</tr>
	{% endfor %}
	{% else %}
	<tr>
		<td class="text-center" colspan="1">{{ text_no_results }}</td>
	</tr>
	{% endif %}
	</tbody>
</table>
</div>
