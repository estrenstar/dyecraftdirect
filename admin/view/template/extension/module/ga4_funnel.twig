{{ header }}{{ column_left }}
<div id="content">
{% if error_warning %}
<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
  <button type="button" class="close" data-dismiss="alert">&times;</button>
</div>
{% endif %}
<div class="container-fluid">
  <div class="panel panel-default">
    <div class="panel-heading">
      <h3 class="panel-title"><i class="fa fa-line-chart"></i> {{ text_edit }}</h3>
    </div>
    <div class="panel-body">
      <form action="{{ action }}" method="post" class="form-horizontal">
        <div class="form-group required">
          <label class="col-sm-2 control-label" for="input-measurement-id">{{ entry_measurement_id }}</label>
          <div class="col-sm-10">
            <input type="text" name="module_ga4_funnel_measurement_id" value="{{ module_ga4_funnel_measurement_id }}" placeholder="G-XXXXXXXX" id="input-measurement-id" class="form-control" />
            {% if error_measurement_id %}
            <div class="text-danger">{{ error_measurement_id }}</div>
            {% endif %}
            <p class="help-block">{{ help_measurement_id }}</p>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_status }}</label>
          <div class="col-sm-10">
            <select name="module_ga4_funnel_status" class="form-control">
              <option value="1" {{ module_ga4_funnel_status ? 'selected' : '' }}>{{ text_enabled }}</option>
              <option value="0" {{ not module_ga4_funnel_status ? 'selected' : '' }}>{{ text_disabled }}</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_user_id }}</label>
          <div class="col-sm-10">
            <select name="module_ga4_funnel_user_id" class="form-control">
              <option value="1" {{ module_ga4_funnel_user_id ? 'selected' : '' }}>{{ text_yes }}</option>
              <option value="0" {{ not module_ga4_funnel_user_id ? 'selected' : '' }}>{{ text_no }}</option>
            </select>
            <p class="help-block">{{ help_user_id }}</p>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_journal }}</label>
          <div class="col-sm-10">
            <select name="module_ga4_funnel_journal" class="form-control">
              <option value="1" {{ module_ga4_funnel_journal ? 'selected' : '' }}>{{ text_yes }}</option>
              <option value="0" {{ not module_ga4_funnel_journal ? 'selected' : '' }}>{{ text_no }}</option>
            </select>
            <p class="help-block">{{ help_journal }}</p>
          </div>
        </div>

        <div class="form-group">
          <label class="col-sm-2 control-label">{{ entry_debug }}</label>
          <div class="col-sm-10">
            <select name="module_ga4_funnel_debug" class="form-control">
              <option value="1" {{ module_ga4_funnel_debug ? 'selected' : '' }}>{{ text_yes }}</option>
              <option value="0" {{ not module_ga4_funnel_debug ? 'selected' : '' }}>{{ text_no }}</option>
            </select>
            <p class="help-block">{{ help_debug }}</p>
          </div>
        </div>

        <div class="text-right">
          <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
          <a href="{{ cancel }}" class="btn btn-default">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
</div>
{{ footer }}