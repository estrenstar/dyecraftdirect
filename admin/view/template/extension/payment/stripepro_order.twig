{% if error %}
<div class="alert alert-danger">
  <strong>Error!</strong> {{ error }}
</div>
{% else %}
<h2>{{ text_stripe_charge }}</h2>
<div class="alert alert-success" id="sagepay_direct_transaction_msg" style="display:none;"></div>
<table class="table table-striped table-bordered">
	<tr>
		<td>{{ text_link }}</td>
		<td><a class="btn btn-info btn-xs" href="https://dashboard.stripe.com/{{ stripe_environment }}/payments/{{ charge['id'] }}" target="_blank">{{ button_stripe }}</a></td>
	</tr>
	<tr>
		<td>{{ text_amount }}</td>
		<td>{{ transaction['amount'] / 100 }} {{ transaction['currency'] | upper }}</td>
	</tr>
	<tr>
		<td>{{ text_fee }}</td>
		<td>{{ transaction['fee'] / 100 }} {{ transaction['currency'] | upper }}</td>
	</tr>
	<tr>
		<td>{{ text_net }}</td>
		<td>{{ transaction['net'] / 100 }} {{ transaction['currency'] | upper }}</td>
	</tr>
	<tr>
		<td>{{ text_refunded }}</td>
		<td>
			{% if charge['amount_refunded'] == charge['amount'] %}
			<span class="label label-warning">{{ text_yes }}</span>
			{% elseif charge['amount_refunded'] > 0 %}
			<span class="label label-success">{{ text_partial }}</span>
			{% else %}
			<span class="label label-info">{{ text_no }}</span>
			{% endif %}
		</td>
	</tr>
	{% if charge['amount_refunded'] < charge['amount'] %}
	<tr>
		<td>{{ text_refund }}</td>
		<td>
			<div class="row">
				<div class="col-sm-3">
					<div class="input-group">
						<input type="text" class="form-control" id="input-refund-amount" value="{{ (charge['amount'] - charge['amount_refunded']) / 100 }}">
						<span class="input-group-addon">{{ charge['currency']|upper }}</span>
					</div>
				</div>
				<div class="col-sm-2">
					<a class="btn btn-primary" id="button-refund" style="display:block">
						<i class="fa fa-circle-o-notch fa-spin fa-lg" id="img-loading-refund" style="display:none;"></i>{{ button_refund }}
					</a>
				</div>
			</div>
		</td>
	</tr>
	{% endif %}
	<tr>
		<td>{{ text_refunds }}</td>
		<td>
			<table class="table table-striped table-bordered" id="stripe_refunds_table">
				<thead>
					<tr>
						<td class="text-left"><strong>{{ text_amount }}</strong></td>
						<td class="text-left"><strong>{{ text_date }}</strong></td>
						<td class="text-left"><strong>{{ text_user }}</strong></td>
					</tr>
				</thead>
				<tbody>
					{% for refund in charge['refunds']['data'] %}
					<tr>
						<td class="text-left">{{ refund['amount'] / 100 }} {{ refund['currency'] | upper }}</td>
						<td class="text-left">{{ refund['created']|date("d/m/Y H:i:s") }}</td>
						<td class="text-left">
							{% if refund['metadata']['opencart_user_username'] %}
							{{ refund['metadata']['opencart_user_username'] }}
							{% endif %}
						</td>
					</tr>
					{% endfor %}
				</tbody>
			</table>
		</td>
	</tr>
</table>
<script type="text/javascript">
	$("#button-refund").click(function() {
			if (confirm('{{ text_confirm_refund }}')) {
				 $.ajax({
					type: 'POST',
					dataType: 'json',
					data: {'order_id': '{{ order_id }}', 'amount': $('#input-refund-amount').val() },
					url: 'index.php?route=extension/payment/stripepro/refund&user_token={{ user_token }}',
					beforeSend: function() {
						$('#button-refund').prop('disabled', true);
						$('#img-loading-refund').show();
					},
					success: function(data) {
						if(data.error == true){
							alert(data.message);
						} else {
							var $table = $('#stripe_refunds_table').find('tbody');
							$table.prepend('<tr><td class="text-left">'+$('#input-refund-amount').val()+'</td><td>Just Now</td><td>You</td></tr>');
						}

						$('#button-refund').prop('disabled', false);
						$('#img-loading-refund').hide();
					}
				});
			}
	  });
</script>
{% endif %}