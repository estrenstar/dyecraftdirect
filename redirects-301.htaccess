# ============================================
# 301 PERMANENT REDIRECTS - DyeCraftDirect
# ============================================
# ONE-HOP ONLY - Direct mappings from CSV
# Query strings preserved via QSA flag
# Generated from canonicals_nonindexable_canonical.csv
# ============================================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Preserve Query String Append
RewriteFlag QSA

