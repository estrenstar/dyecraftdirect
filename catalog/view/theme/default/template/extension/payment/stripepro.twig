	</div>

	{% if cards %}
	<fieldset>
		<legend>{{ text_choose_existing_card }}</legend>
		<div class="form-group col-sm-12">
			<label class="control-label" for="card-number">{{ text_cards }}</label>
			<select class="form-control" id="select_saved_card">
				<option value="0">{{ text_select_a_card }}</option>
				{% for card in cards %}
				<option value="{{ card.payment_method_id }}">
					{{ card.brand }}
					**** **** **** {{ card.last4 }} ({{ card.exp_month }}/{{ card.exp_year }})
				</option>
				{% endfor %}
			</select>
		</div>
		<button type="button" id="saved-card-payment" class="buttons">{{ button_submit_payment }}</button>
	</fieldset>
	{% endif %}
	<fieldset>

		<legend class="card-only">{{ text_pay_with_card }}</legend>

		<div class="container-stripe">
			<!-- placeholder for Elements -->
			<div id="card-element"></div>
			{% if store_card_allow %}
			<label class="checkbox-inline"><input type="checkbox" class="checkbox_save_card" name="store_my_card" value="1" {% if store_card_prechecked %}checked{% endif %} />{{ text_save_card }}</label>
			{% endif %}
			<button type="button" id="button-confirm" class="buttons">{{ button_submit_payment }}</button>
		</div>
	</fieldset>
	<div class="error-stripe" role="alert">
		<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17">
			<path class="base" fill="#000" d="M8.5,17 C3.80557963,17 0,13.1944204 0,8.5 C0,3.80557963 3.80557963,0 8.5,0 C13.1944204,0 17,3.80557963 17,8.5 C17,13.1944204 13.1944204,17 8.5,17 Z"></path>
			<path class="glyph" fill="#FFF" d="M8.5,7.29791847 L6.12604076,4.92395924 C5.79409512,4.59201359 5.25590488,4.59201359 4.92395924,4.92395924 C4.59201359,5.25590488 4.59201359,5.79409512 4.92395924,6.12604076 L7.29791847,8.5 L4.92395924,10.8739592 C4.59201359,11.2059049 4.59201359,11.7440951 4.92395924,12.0760408 C5.25590488,12.4079864 5.79409512,12.4079864 6.12604076,12.0760408 L8.5,9.70208153 L10.8739592,12.0760408 C11.2059049,12.4079864 11.7440951,12.4079864 12.0760408,12.0760408 C12.4079864,11.7440951 12.4079864,11.2059049 12.0760408,10.8739592 L9.70208153,8.5 L12.0760408,6.12604076 C12.4079864,5.79409512 12.4079864,5.25590488 12.0760408,4.92395924 C11.7440951,4.59201359 11.2059049,4.59201359 10.8739592,4.92395924 L8.5,7.29791847 L8.5,7.29791847 Z"></path>
		</svg>
		<span id="card-errors" class="message"></span>
	</div>
</form>
<div class="success-stripe">
	<div class="icon">
		<svg width="84px" height="84px" viewBox="0 0 84 84" version="1.1" xmlns="http://www.w3.org/2000/svg" xlink="http://www.w3.org/1999/xlink">
			<circle class="border" cx="42" cy="42" r="40" stroke-linecap="round" stroke-width="4" stroke="#000" fill="none"></circle>
		</svg>
	</div>
</div>
</div>
<script type="text/javascript" src="https://js.stripe.com/v3/"></script>
<script type="text/javascript">
var billing_details = {{ billing_details|json_encode|raw }};

function initStripe() {

	if (window.Stripe) {

		const stripe = Stripe('{{ payment_stripepro_public_key }}');
		const elements = stripe.elements({% if locale %}{"locale": "{{ locale }}"}{% endif %});

		var style = {
					base: {
						color: "#32325D",
						fontWeight: 500,
						fontFamily: "Inter UI, Open Sans, Segoe UI, sans-serif",
						fontSize: "15px",
						fontSmoothing: "antialiased",
						"::placeholder": {
							color: "#CFD7DF"
						}
					},
					invalid: {
						 color: "#E25950"
					}
				};

		const cardElement = elements.create('card', {style: style, hidePostalCode: true});
		cardElement.mount('#card-element');
		const cardButton = document.getElementById('button-confirm');

		cardButton.addEventListener('click', async (ev) => {
			$('.payment-form-wrapper').addClass('submitting');
			const {paymentMethod, error} = await stripe.createPaymentMethod('card', cardElement, {
				'billing_details': billing_details
			});
			if (error) {
				// Show error in payment form
				showErrorMessage(error.message);
			} else {
				var d = JSON.stringify({ 
					payment_method_id: paymentMethod.id,
					store_my_card: _store_my_card()
				});
				processPaymentForm(d);
			}
		});


		{% if cards %}
		savedCardButton = document.getElementById('saved-card-payment');
		savedCardButton.addEventListener('click', async (ev) => {
			$("#select_saved_card").parent().removeClass('has-error');
			$('.payment-form-wrapper').addClass('submitting');

			var selected_saved_card = $("#select_saved_card").find("option:selected").val();
			
			if(selected_saved_card != "0"){

				var d = JSON.stringify({ 
								payment_method_id: selected_saved_card,
								using_saved_card: true
							});
				processPaymentForm(d);

			} else {
				$("#select_saved_card").parent().addClass('has-error');
				$("#select_saved_card").closest('fieldset').addClass('shake-it');
				setTimeout(function(){
					$("#select_saved_card").closest('fieldset').removeClass('shake-it');
				}, 500);
				$('.payment-form-wrapper').removeClass('submitting');
			}
		});
		{% endif %}


		const processPaymentForm = async (data) => {
			// Send paymentMethod.id to your server (see Step 2)
			const response = await fetch('{{ action }}', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: data
			});

			const json = await response.text();

			// Handle server response (see Step 3)
			handleServerResponse(json);
		}

		const handleServerResponse = async (response) => {

			try {
				response = JSON.parse(response);
			} catch {
				console.warn("Stripe App have encountered with some error. This error might not be caused by Stripe App. Such errors come when Stripe App receive unexpected JSON response from your server.");
				console.warn("Please see below the response your server sent, whereas JSON was expected by Stripe App.");
				console.error(response);
				return;
			}
			
			if (response.error) {
				// Show error from server on payment form
				showErrorMessage(response.error);
			} else if (response.requires_action) {
				// Use Stripe.js to handle the required card action
				const { error: errorAction, paymentIntent } = await stripe.handleCardAction(response.payment_intent_client_secret);
	
				if (errorAction) {
					// Show error from Stripe.js in payment form
					showErrorMessage(errorAction.message);
				} else {
					// The card action has been handled
					// The PaymentIntent can be confirmed again on the server
					const serverResponse = await fetch('{{ action }}', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ payment_intent_id: paymentIntent.id })
					});
					handleServerResponse(await serverResponse.text());
				}
			} else {
				// Show success message
				window.location = response.success;
			}
		}

		const showErrorMessage = (error) => {
			$(".payment-form-wrapper #card-errors").text(error);
			$(".payment-form-wrapper .error-stripe").addClass("visible");
			$('.payment-form-wrapper').removeClass('submitting');
		}


		/* Apple Pay and Google Pay */
		var paymentRequest = stripe.paymentRequest({
			 country: 'US',
			 currency: '{{ currency }}'.toLowerCase(),
			 total: {
				  label: 'Total',
				  amount: parseInt('{{ amount }}'),
			 },
		});

		paymentRequest.canMakePayment().then(function (result) {
			console.log("Payment Support", result);
			 if (result) {

			 		if(typeof result.applePay !== "undefined" && result.applePay !== false) {
						$("#apple-pay-button").show();
			 		} else {
			 			$("#google-pay-button").show();
			 		}

			 		/*
			 		if(typeof result.applePay === "undefined" || result.applePay == false) {
						$("#apple-pay-button").hide();
			 		} else {
			 			$("#apple-pay-button").show();
			 		}

			 		if(typeof result.googlePay === "undefined" || result.googlePay == false) {
			 			$("#google-pay-button").hide();
			 		} else {
			 			$("#google-pay-button").show();
			 		}
			 		*/


					$(".card-only").text('{{ text_or_pay_with_card }}');
					$(".payment-button").show();
					var prButton = elements.create('paymentRequestButton', {
						paymentRequest: paymentRequest
					});
			 } else {
			 	// apple pay is not available
				$(".card-only").text('{{ text_pay_with_card }}');
				$(".payment-button").hide();
			 }
		});

		$('#google-pay-button, #apple-pay-button').click(function(){
			paymentRequest.show();
		});

		// complete the payment using the emitted Token or PaymentMethod
		paymentRequest.on('paymentmethod', async (ev) => {
			stripe.confirmCardPayment('{{ client_secret }}',{ 
				'payment_method': ev.paymentMethod.id
			}).then(function(response) {
				if (response.error) {
					// Display error.message in your UI.
					showErrorMessage(response.error.message);
				} else {
					// The payment has succeeded
					// Display a success message
					// The payment has succeeded.
					var d = JSON.stringify({ 
						payment_intent_id: response.paymentIntent.id,
						capture_method: response.paymentIntent.capture_method
					});
					processPaymentForm(d);
				}
			});
		});
		/* Apple Pay and Google Pay */

	} else {
		 setTimeout(function() { initStripe() }, 50);
	}
}


function _store_my_card() {
	// set save card param if allowed by customer
	if ($(".checkbox_save_card").is(":checked") && ($("#select_saved_card").length == 0 || $("#select_saved_card").find("option:selected").val() == "0")) {
		return true;
	} else {
		return false;
	}
}

initStripe();
</script>